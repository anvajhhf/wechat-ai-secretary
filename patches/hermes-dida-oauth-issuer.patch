+def _normalize_root_issuer_trailing_slash(
+    value: str | None,
+    allowed_host: str,
+) -> str | None:
+    """Strip only a root-path slash for an explicitly allowlisted HTTPS host.
+
+    Some authorization servers publish ``https://host/`` in protected-resource
+    metadata but ``https://host`` as the authorization metadata issuer.  The
+    MCP SDK correctly performs an exact RFC 8414 comparison, so that provider
+    defect otherwise blocks OAuth.  This helper deliberately does *not*
+    normalize paths, ports, schemes, userinfo, queries, fragments, or hosts.
+    """
+    if not value or not allowed_host:
+        return value
+    from urllib.parse import urlsplit, urlunsplit
+
+    try:
+        parsed = urlsplit(value)
+    except ValueError:
+        return value
+    if (
+        parsed.scheme.lower() != "https"
+        or parsed.netloc.lower() != allowed_host.strip().lower()
+        or parsed.path != "/"
+        or parsed.query
+        or parsed.fragment
+    ):
+        return value
+    return urlunsplit((parsed.scheme, parsed.netloc, "", "", ""))
+
+
