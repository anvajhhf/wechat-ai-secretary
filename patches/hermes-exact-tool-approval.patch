+            and item.strip()
+            and item.strip() in discovered_names
+        }
+        conditional = (config or {}).get("operator_approved_tools_when_env", {})
+        if not isinstance(conditional, dict):
+            logger.warning(
+                "MCP trust: %s.operator_approved_tools_when_env must be a "
+                "mapping; ignoring it (fail-closed)",
