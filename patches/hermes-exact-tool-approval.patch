--- a/tools/mcp_tool.py
+++ b/tools/mcp_tool.py
@@ -4334,6 +4334,8 @@ _CIRCUIT_BREAKER_COOLDOWN_SEC = 60.0
 # byte-stable and prompt caching is preserved.
 _server_trust_levels: Dict[str, str] = {}
 _tool_read_only_hints: Dict[str, Dict[str, bool]] = {}
+_operator_approved_tools: Dict[str, set[str]] = {}
+_operator_approved_tools_when_env: Dict[str, Dict[str, set[str]]] = {}
 
 _TRUST_FULL = "full"
 _TRUST_UNTRUSTED = "untrusted"
@@ -4381,16 +4383,62 @@ def _annotation_read_only_hint(mcp_tool: Any) -> bool:
 def _record_tool_trust_metadata(
     server_name: str, config: dict, tools: List[Any]
 ) -> None:
-    """Capture per-server trust and per-tool readOnlyHint at discovery."""
+    """Capture trust metadata and exact operator-approved names at discovery.
+
+    ``operator_approved_tools`` is an opt-in local configuration list.  It is
+    intentionally exact-name based and intersected with the tools discovered
+    from this server, so a typo or stale name never broadens access.
+    """
     with _lock:
         _server_trust_levels[server_name] = _normalize_server_trust(
             (config or {}).get("trust")
         )
         hints = _tool_read_only_hints.setdefault(server_name, {})
+        discovered_names: set[str] = set()
         for tool in tools:
             name = getattr(tool, "name", None)
             if name:
+                discovered_names.add(name)
                 hints[name] = _annotation_read_only_hint(tool)
+        configured = (config or {}).get("operator_approved_tools", [])
+        if not isinstance(configured, list):
+            logger.warning(
+                "MCP trust: %s.operator_approved_tools must be a list; "
