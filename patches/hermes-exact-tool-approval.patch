+                or not isinstance(items, list)
+            ):
+                continue
+            approved_when_env[env_name] = {
+                item.strip()
+                for item in items
+                if isinstance(item, str)
+                and item.strip()
+                and item.strip() in discovered_names
+            }
+        _operator_approved_tools_when_env[server_name] = approved_when_env
 
 
 def _trust_gate_check(server_name: str, tool_name: str) -> Optional[str]:
